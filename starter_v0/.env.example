# Day 04 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE) ---
# ViLao (OpenAI-compatible) — provider nhóm đang dùng: --provider vilao
VILAO_API_KEY=
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_MODEL=occ/claude-sonnet-4-6
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)

# --- Team finance tools ---
ALPHAVANTAGE_API_KEY=
# Optional: CoinGecko chạy được không cần key, có key thì rate limit cao hơn
# COINGECKO_API_KEY=
# validate_finance_content là local tool, không cần env var

# --- Team publishing tools ---
# Bắt buộc cho send_telegram. Để TRỐNG khi chạy run_eval.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: chỉ cần nếu dùng destination=test
# TELEGRAM_TEST_CHAT_ID=
# Optional: chỉ cần nếu dùng publish_facebook_page
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v21.0
